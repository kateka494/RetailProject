@{
    ViewData["Title"] = "Register Customer";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                    <h4 class="fw-bold"><i class="fas fa-user-plus me-2" style="color: #2E4A8A;"></i> Register New Customer</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">First Name</label>
                            <input type="text" name="firstName" class="form-control" placeholder="John" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Last Name</label>
                            <input type="text" name="lastName" class="form-control" placeholder="Doe" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email Address</label>
                            <input type="email" name="email" class="form-control" placeholder="john.doe@example.com" required />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-dark px-4 py-2 fw-semibold">
                                <i class="fas fa-save me-2"></i> Register
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-semibold">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>