@model List<RetailProject.Models.Customer>
@{
    ViewData["Title"] = "Customer Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fas fa-users me-2"></i> Customer Management</h2>
        <a asp-action="Create" class="btn btn-dark rounded-pill px-4">
            <i class="fas fa-user-plus me-2"></i> Register Customer
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3">Name</th>
                        <th>Email Address</th>
                        <th>Registered</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3 fw-semibold">@customer.FirstName @customer.LastName</td>
                                <td>@customer.EmailAddress</td>
                                <td>@customer.DateRegistered.ToString("dd MMM yyyy")</td>
                                <td class="text-end pe-4">
                                  
                                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete @customer.FirstName?');">
                                        <input type="hidden" name="id" value="@customer.CustomerId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            <i class="fas fa-trash-alt me-1"></i> Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                <i class="fas fa-user fa-2x d-block mb-2 text-light" style="color: #e9ecef !important;"></i>
                                No customers registered yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>