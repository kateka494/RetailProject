@model RetailProject.Models.Product
@{
    ViewData["Title"] = "Edit Product";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                    <h4 class="fw-bold"><i class="fas fa-edit me-2" style="color: #2E4A8A;"></i> Edit Product</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" name="productId" value="@Model.ProductId" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Product Name</label>
                            <input type="text" name="productName" class="form-control" value="@Model.ProductName" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Category</label>
                            <input type="text" name="productCategory" class="form-control" value="@Model.ProductCategory" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Price (R)</label>
                            <input type="number" step="0.01" name="productPrice" class="form-control" value="@Model.ProductPrice" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Description</label>
                            <textarea name="productDescription" class="form-control" rows="3">@Model.ProductDescription</textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-dark px-4 py-2 fw-semibold">
                                <i class="fas fa-save me-2"></i> Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-semibold">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>