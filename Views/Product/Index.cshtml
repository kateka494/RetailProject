@model List<RetailProject.Models.Product>
@{
    ViewData["Title"] = "Product Catalog";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fas fa-boxes me-2"></i> Product Catalog</h2>
        <a asp-action="Create" class="btn btn-dark rounded-pill px-4">
            <i class="fas fa-plus me-2"></i> Add New Product
        </a>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Count > 0)
        {
            @foreach (var product in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

                        <!-- FIX: Changed from ImageBlobUrl to ImageUrls -->
                        @if (!string.IsNullOrEmpty(product.ImageUrls))
                        {
                            <img src="@product.ImageUrls" class="card-img-top" style="height: 250px; object-fit: cover;" alt="@product.ProductName" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                                <i class="fas fa-image fa-3x text-muted"></i>
                            </div>
                        }

                        <div class="card-body p-4">
                            <h5 class="fw-bold card-title">@product.ProductName</h5>

                            <!-- FIX: Added ProductCategory display -->
                            <p class="text-muted small mb-2">
                                <i class="far fa-tag me-1"></i> @product.ProductCategory
                            </p>
                            <p class="text-muted small mb-2">
                                <i class="far fa-calendar-alt me-1"></i> Added: @product.DateAdded.ToString("dd MMM yyyy")
                            </p>

                            <!-- FIX: Changed from Price to ProductPrice -->
                            <h4 class="text-success fw-bold">R @product.ProductPrice.ToString("N2")</h4>
                        </div>
                    </div>
                    
                    <div class="d-flex gap-2 mt-3">
                      
                        <a href="/Product/Edit/@product.ProductId" class="btn btn-sm btn-outline-secondary flex-fill rounded-pill">
                            <i class="fas fa-edit me-1"></i> Edit
                        </a>

                       
                        <form action="/Product/Delete" method="post" class="flex-fill" onsubmit="return confirm('Are you sure?');">
                            <input type="hidden" name="productId" value="@product.ProductId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-pill">
                                <i class="fas fa-trash-alt me-1"></i> Delete
                            </button>
                        </form>
                    </div>
                    </div>
               
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="fas fa-box-open fa-4x mb-3 text-light" style="color: #e9ecef !important;"></i>
                <h4 class="text-muted">No products found</h4>
                <p class="text-muted">Click the button above to add your first product with an image!</p>
            </div>
        }
    </div>
</div>