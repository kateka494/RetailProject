@{
    ViewData["Title"] = "ABC Retail - Home";
}

<!-- Font Awesome for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container py-4">
    <!-- Welcome Banner -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="p-5 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #1E2A47 0%, #2E4A8A 100%);">
                <h1 class="display-4 fw-bold">Welcome to ABC Retail</h1>
                <p class="lead opacity-85 mb-3">Your trusted online store for quality products.</p>
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <div class="d-flex gap-3 flex-wrap">
                            <span class="bg-white bg-opacity-10 px-3 py-2 rounded-pill"><i class="fas fa-check-circle me-2"></i> Connected to Azure</span>
                            <span class="bg-white bg-opacity-10 px-3 py-2 rounded-pill"><i class="far fa-clock me-2"></i> @DateTime.Now.ToString("dddd, MMMM dd, yyyy HH:mm")</span>
                        </div>
                    </div>
                    <div class="col-md-6 text-md-end mt-3 mt-md-0">
                        <a asp-controller="Product" asp-action="Index" class="btn btn-light btn-lg fw-semibold text-dark shadow-sm">
                            <i class="fas fa-store me-2"></i> Browse Products
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row mb-5 g-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4 text-center">
                    <div class="d-flex justify-content-center align-items-center bg-primary bg-opacity-10 rounded-circle mb-3 mx-auto" style="width: 60px; height: 60px; color: #1E2A47;">
                        <i class="fas fa-users fa-lg"></i>
                    </div>
                    <h5 class="text-muted text-uppercase small fw-bold tracking-wide">Total Customers</h5>
                    <h2 class="mb-0 fw-bold text-dark">@ViewBag.TotalCustomers</h2>
                    <small class="text-muted">Registered users</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4 text-center">
                    <div class="d-flex justify-content-center align-items-center bg-success bg-opacity-10 rounded-circle mb-3 mx-auto" style="width: 60px; height: 60px; color: #1F7042;">
                        <i class="fas fa-box fa-lg"></i>
                    </div>
                    <h5 class="text-muted text-uppercase small fw-bold tracking-wide">Total Products</h5>
                    <h2 class="mb-0 fw-bold text-dark">@ViewBag.TotalProducts</h2>
                    <small class="text-muted">In catalog</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4 text-center">
                    <div class="d-flex justify-content-center align-items-center bg-info bg-opacity-10 rounded-circle mb-3 mx-auto" style="width: 60px; height: 60px; color: #0F5C7A;">
                        <i class="fas fa-cloud fa-lg"></i>
                    </div>
                    <h5 class="text-muted text-uppercase small fw-bold tracking-wide">System Status</h5>
                    <h2 class="mb-0 text-success fw-bold"><i class="fas fa-check-circle"></i> Active</h2>
                    <small class="text-muted">Azure Connected</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Customers & Featured Products -->
    <div class="row mb-5 g-4">
        <!-- Recent Customers -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-user-plus me-2 text-primary" style="color: #1E2A47;"></i> Recent Customers</h5>
                </div>
                <div class="card-body px-4 pb-4">
                    @if (ViewBag.RecentCustomers != null && ViewBag.RecentCustomers.Count > 0)
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var customer in ViewBag.RecentCustomers)
                            {
                                <div class="list-group-item border-0 px-0 py-3 d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong class="text-dark">@customer.FirstName @customer.LastName</strong>
                                        <br />
                                        <small class="text-muted"><i class="far fa-envelope me-1"></i> @customer.EmailAddress</small>
                                    </div>
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-2 fw-normal">
                                        @customer.DateRegistered.ToString("dd MMM")
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">
                            <i class="fas fa-user fa-2x d-block mb-3 text-light" style="color: #e9ecef !important;"></i>
                            No customers registered yet
                        </p>
                    }
                </div>
            </div>
        </div>

        <!-- Featured Products -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-star me-2 text-warning"></i> Featured Products</h5>
                </div>
                <div class="card-body px-4 pb-4">
                    @if (ViewBag.FeaturedProducts != null && ViewBag.FeaturedProducts.Count > 0)
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var product in ViewBag.FeaturedProducts)
                            {
                                <div class="list-group-item border-0 px-0 py-3 d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong class="text-dark">@product.ProductName</strong>
                                        <br />
                                        <small class="text-muted"><i class="far fa-tag me-1"></i> @product.ProductCategory</small>
                                    </div>
                                    <span class="badge bg-dark text-white rounded-pill px-3 py-2 fw-normal">
                                        R @product.ProductPrice.ToString("N2")
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">
                            <i class="fas fa-box-open fa-2x d-block mb-3 text-light" style="color: #e9ecef !important;"></i>
                            No products available
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Blob Gallery (Azure Blob Storage) -->
    <div class="card border-0 shadow-sm rounded-4 mb-5 overflow-hidden">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
            <h5 class="mb-0 fw-bold"><i class="fas fa-images me-2" style="color: #2E4A8A;"></i> Product Gallery</h5>
        </div>
        <div class="card-body p-4">
            @if (ViewBag.ProductImages != null && ViewBag.ProductImages.Count > 0)
            {
                <!-- Carousel -->
                <div id="blobGalleryCarousel" class="carousel slide rounded-3 overflow-hidden shadow-sm" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @{
                            var first = true;
                            foreach (var imgUrl in ViewBag.ProductImages)
                            {
                                <div class="carousel-item @(first ? "active" : "")">
                                    <img src="@imgUrl" class="d-block w-100" style="height: 400px; object-fit: cover;" alt="Product Image" />
                                </div>
                                first = false;
                            }
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#blobGalleryCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" style="background-color: rgba(0,0,0,0.4); border-radius: 50%; padding: 15px;"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#blobGalleryCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" style="background-color: rgba(0,0,0,0.4); border-radius: 50%; padding: 15px;"></span>
                    </button>
                </div>

                <!-- Grid alternative -->
                <div class="row g-3 mt-4">
                    @foreach (var imgUrl in ViewBag.ProductImages)
                    {
                        <div class="col-md-3 col-6">
                            <div class="rounded-3 overflow-hidden shadow-sm">
                                <img src="@imgUrl" class="img-fluid w-100" style="height: 150px; object-fit: cover; transition: transform 0.3s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" alt="Product Image" />
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted text-center py-4">
                    <i class="fas fa-image fa-2x d-block mb-3 text-light" style="color: #e9ecef !important;"></i>
                    No product images available
                </p>
            }
        </div>
    </div>

    <!-- Azure Storage Status -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-cloud me-2" style="color: #2E4A8A;"></i> Azure Storage Status</h5>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="row g-2 text-center">
                        <div class="col-md-3 col-6">
                            <div class="p-3 bg-light rounded-3">
                                <span class="d-block mb-1 text-success fw-bold"><i class="fas fa-check-circle"></i> Tables</span>
                                <p class="mb-0 text-muted small">@ViewBag.TotalCustomers Customers</p>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="p-3 bg-light rounded-3">
                                <span class="d-block mb-1 text-success fw-bold"><i class="fas fa-check-circle"></i> Blobs</span>
                                <p class="mb-0 text-muted small">@(ViewBag.ProductImages?.Count ?? 0) Images</p>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="p-3 bg-light rounded-3">
                                <span class="d-block mb-1 text-success fw-bold"><i class="fas fa-check-circle"></i> Queues</span>
                                <p class="mb-0 text-muted small">Ready</p>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="p-3 bg-light rounded-3">
                                <span class="d-block mb-1 text-success fw-bold"><i class="fas fa-check-circle"></i> Files</span>
                                <p class="mb-0 text-muted small">Ready</p>
                            </div>
                        </div>
                    </div>
                    <hr class="my-3" />
                    <p class="text-center text-muted mb-0 small">
                        <i class="fas fa-check-circle text-success me-1"></i> All Azure services are connected and running
                    </p>
                </div>
            </div>
        </div>
    </div>

    
            

<!-- Bootstrap JS for Carousel -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<style>
    /* Clean, mature color variables */
    :root {
        --brand-dark: #1E2A47;
        --brand-blue: #2E4A8A;
        --brand-gray: #6c757d;
        --brand-light-bg: #f8f9fa;
    }

    body {
        background-color: #f5f6f8;
        color: #333333;
    }

    .card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.05) !important;
        }

    .list-group-item {
        transition: background-color 0.15s ease;
    }

        .list-group-item:hover {
            background-color: #f8f9fa;
        }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-color: rgba(0, 0, 0, 0.4);
        border-radius: 50%;
        padding: 15px;
    }

    /* NOTE: Double '@@' fixes the Razor parsing error */
    @@media (max-width: 768px) {
        .carousel-item img {
            height: 220px !important;
        }
    }
</style>